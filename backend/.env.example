# Never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# Draft safety translations stay disabled until reviewed by the project owner/technician.
SAFETY_STRINGS_APPROVED=false

# Comma-separated browser origins. Add the production Vercel origin before deployment.
CORS_ORIGINS=http://localhost:3000
SERVICE_VERSION=0.1.0
